#
# A tiny Flask service that proves the DB dependency on every request, so the
# incident drills (5xx, latency, DB failure) exercise a real request path.
# Two flag files let a drill inject failure deterministically and safely:
#   {{ copsapp_dir }}/FORCE_500  -> return 500   (elevated-5xx drill)
#   {{ copsapp_dir }}/FORCE_SLOW -> add latency  (latency drill)
import os
import json
import time

import boto3
import psycopg2
from flask import Flask

app = Flask(__name__)
_sm = boto3.client("secretsmanager", region_name=os.environ.get("AWS_REGION", "{{ copsapp_region }}"))


def _creds():
    s = json.loads(_sm.get_secret_value(SecretId=os.environ["DB_SECRET_ARN"])["SecretString"])
    return s["username"], s["password"]


def _db_check():
    u, p = _creds()
    conn = psycopg2.connect(
        host=os.environ["DB_HOST"],
        dbname=os.environ.get("DB_NAME", "postgres"),
        user=u, password=p, connect_timeout=3,
    )
    cur = conn.cursor()
    cur.execute("SELECT 1")
    cur.fetchone()
    cur.close()
    conn.close()


@app.route("/health")
def health():
    # Health reflects the real dependency only (DB), NOT the FORCE_500 drill
    # toggle — so an elevated-5xx drill keeps targets healthy and generates
    # genuine Target_5XX rather than flipping the ALB to 503/ELB_5XX.
    try:
        _db_check()
        return ("ok", 200)
    except Exception as e:  # noqa: BLE001
        return ("db-error: %s" % e, 500)


@app.route("/")
def index():
    if os.path.exists("{{ copsapp_dir }}/FORCE_SLOW"):
        time.sleep(5)
    if os.path.exists("{{ copsapp_dir }}/FORCE_500"):
        return ("forced-500", 500)
    try:
        _db_check()
        return ("Cloud Ops Lab - app healthy\n", 200)
    except Exception as e:  # noqa: BLE001
        return ("db-error: %s\n" % e, 500)
